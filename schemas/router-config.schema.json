{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "generated_by", "source_repository", "source_commit", "repo_id", "repositories", "protected_branch_patterns", "ignore_paths", "supported_languages", "module_discovery", "repo_stage", "repo_stage_score", "repo_stage_reasons", "repo_stage_signals", "freshness_windows", "evaluation", "route_reports_dir", "rebuild_reports_dir", "guardrail_reports_dir", "evaluation_reports_dir"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string" },
    "generated_by": { "type": "string" },
    "source_repository": { "type": "string" },
    "source_commit": { "type": ["string", "null"] },
    "repo_id": { "type": "string" },
    "repositories": { "type": "array", "items": { "type": "object" } },
    "protected_branch_patterns": { "type": "array", "items": { "type": "string" } },
    "ignore_paths": { "type": "array", "items": { "type": "string" } },
    "supported_languages": { "type": "array", "items": { "type": "string" } },
    "module_discovery": { "type": "object" },
    "repo_stage": { "type": "string" },
    "repo_stage_score": { "type": "number" },
    "repo_stage_reasons": { "type": "array", "items": { "type": "string" } },
    "repo_stage_signals": { "type": "object" },
    "freshness_windows": { "type": "object" },
    "evaluation": {
      "type": "object",
      "properties": {
        "enforcement_enabled": { "type": "boolean" },
        "top1_accuracy_threshold": { "type": "number", "minimum": 0.85, "maximum": 1 },
        "top1_capability_accuracy_threshold": { "type": "number", "minimum": 0.85, "maximum": 1 },
        "review_precision_threshold": { "type": "number", "minimum": 0.90, "maximum": 1 },
        "review_recall_threshold": { "type": "number", "minimum": 1, "maximum": 1 },
        "secondary_contract_accuracy_threshold": { "type": "number", "minimum": 1, "maximum": 1 },
        "minimum_capability_coverage_ratio": { "type": "number", "minimum": 0.80, "maximum": 1 },
        "minimum_case_count": { "type": "integer", "minimum": 30 },
        "mode": { "type": "string" },
        "attestation": {
          "type": "object",
          "properties": {
            "evaluation_engine_version": { "type": "integer", "minimum": 1 },
            "input_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "metrics": { "type": "object" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "route_reports_dir": { "type": "string" },
    "rebuild_reports_dir": { "type": "string" },
    "guardrail_reports_dir": { "type": "string" },
    "evaluation_reports_dir": { "type": "string" }
  },
  "additionalProperties": true
}
