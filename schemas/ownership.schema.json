{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "generated_by", "source_repository", "source_commit", "owners"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string" },
    "generated_by": { "type": "string" },
    "source_repository": { "type": "string" },
    "source_commit": { "type": ["string", "null"] },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "target", "primary", "reviewers", "provisional"],
        "properties": {
          "scope": { "type": "string", "enum": ["capability", "module"] },
          "target": { "type": "string", "minLength": 1 },
          "primary": { "type": "string", "minLength": 1 },
          "reviewers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "escalation_group": { "type": "string", "minLength": 1 },
          "provisional": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
