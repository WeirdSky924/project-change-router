  "properties": {
    "run_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "case_count": { "type": "integer" },
    "top1_action_accuracy": { "type": "number" },
    "top1_capability_accuracy": { "type": "number" },
    "review_precision": { "type": "number" },
    "review_recall": { "type": "number" },
    "false_positive_count": { "type": "integer" },
    "false_negative_count": { "type": "integer" },
    "capability_count": { "type": "integer" },
    "covered_capability_count": { "type": "integer" },
    "capability_coverage_ratio": { "type": "number" },
    "uncovered_capabilities": { "type": "array", "items": { "type": "string" } },
    "per_case_results": { "type": "array", "items": { "type": "object" } },
    "evaluation_mode": { "type": "string" },
    "status": { "type": "string" },
    "status_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
