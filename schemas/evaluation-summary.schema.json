{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["run_id", "timestamp", "case_count", "top1_action_accuracy", "top1_capability_accuracy", "review_precision", "review_recall", "false_positive_count", "false_negative_count", "capability_count", "covered_capability_count", "capability_coverage_ratio", "secondary_contract_accuracy", "strict_secondary_case_count", "uncovered_capabilities", "per_case_results", "evaluation_mode", "enforcement_mode", "status", "status_reasons", "runtime_identity"],
  "properties": {
    "run_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "case_count": { "type": "integer", "minimum": 0 },
    "top1_action_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "top1_capability_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_precision": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_recall": { "type": "number", "minimum": 0, "maximum": 1 },
    "false_positive_count": { "type": "integer", "minimum": 0 },
    "false_negative_count": { "type": "integer", "minimum": 0 },
    "capability_count": { "type": "integer", "minimum": 0 },
    "covered_capability_count": { "type": "integer", "minimum": 0 },
    "capability_coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "secondary_contract_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "strict_secondary_case_count": { "type": "integer", "minimum": 0 },
    "uncovered_capabilities": { "type": "array", "items": { "type": "string" } },
    "per_case_results": { "type": "array", "items": { "type": "object" } },
    "evaluation_mode": { "type": "string" },
    "enforcement_mode": { "type": "string", "enum": ["normal", "review_only"] },
    "status": { "type": "string" },
    "status_reasons": { "type": "array", "items": { "type": "string" } },
    "runtime_identity": { "$ref": "https://project-change-router.dev/schemas/runtime-identity.schema.json" }
  },
  "additionalProperties": true
}
