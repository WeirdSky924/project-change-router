{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["report_id", "timestamp", "script", "status", "blocking", "summary", "findings", "runtime_identity"],
  "properties": {
    "report_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "script": { "type": "string" },
    "status": { "type": "string" },
    "blocking": { "type": "boolean" },
    "summary": { "type": "object" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "runtime_identity": { "$ref": "https://project-change-router.dev/schemas/runtime-identity.schema.json" }
  },
  "additionalProperties": true
}
