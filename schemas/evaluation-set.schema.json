{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "generated_by", "source_repository", "source_commit", "mode", "cases"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string" },
    "generated_by": { "type": "string" },
    "source_repository": { "type": "string" },
    "source_commit": { "type": ["string", "null"] },
    "mode": { "type": "string", "enum": ["generated_only", "curated", "hybrid"] },
    "curated_case_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expected_primary_capability": { "type": "string", "minLength": 1 },
          "expected_secondary_capabilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "secondary_match": { "type": "string", "enum": ["exact", "contains"] },
          "calibration_category": {
            "type": "string",
            "enum": [
              "positive_reuse",
              "positive_extend",
              "extract_boundary",
              "review_veto",
              "false_positive_regression",
              "false_negative_regression"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
